<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Exclude EF Core auto-generated code (migrations + model snapshot) from
         coverage. It is generated, not hand-written logic, so it is not
         meaningfully unit-testable and would otherwise sink the CI diff-coverage
         gate (diff-cover over changed lines). -->
    <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.17.2" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EventService.Api\EventService.Api.csproj" />
    <ProjectReference Include="..\..\src\EventService.Application\EventService.Application.csproj" />
    <ProjectReference Include="..\..\src\EventService.Contracts\EventService.Contracts.csproj" />
    <ProjectReference Include="..\..\src\EventService.Domain\EventService.Domain.csproj" />
  </ItemGroup>

</Project>
